# Local default. On Hostinger, PORT is optional (app falls back to 3000).
PORT=3001
CORS_ORIGIN=http://localhost:3000
# Public site origin for email CTA links (defaults to first CORS_ORIGIN entry).
FRONTEND_URL=http://localhost:3000

PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_WITH_YOUR_PAYSTACK_PUBLIC_KEY
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_PAYSTACK_SECRET_KEY
JWT_SECRET=replace_with_a_long_random_string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin_change_me

# Transactional email (Resend). Without RESEND_API_KEY, mail is logged to the console (demo mode).
RESEND_API_KEY=re_REPLACE_WITH_YOUR_RESEND_API_KEY
MAIL_FROM=Mid-Side Audio <noreply@your-verified-domain.com>
# Admin alerts (E8/E9); defaults to ADMIN_EMAIL.
# MAIL_ADMIN_TO=studio@example.com

# MySQL (local: docker compose up -d mysql)
# On Hostinger use 127.0.0.1 (not localhost) and do NOT set PORT — Hostinger injects it.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mixing
MYSQL_PASSWORD=mixing
MYSQL_DATABASE=kemena_mixing
# Or a single URL instead of the MYSQL_* vars:
# DATABASE_URL=mysql://mixing:mixing@127.0.0.1:3306/kemena_mixing
